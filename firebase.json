{
  "hosting": [
    {
      "target": "engx",
      "public": "www_engx",
      "ignore": [
        "firebase.json",
        "**/*.js.map",
        "**/.*",
        "book.yaml",
        "cover.png"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [{ "key": "tdm-reservation", "value": "1" }]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "almaat",
      "public": "www_almaat",
      "ignore": [
        "firebase.json",
        "**/*.js.map",
        "**/.*",
        "book.yaml",
        "cover.png"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
