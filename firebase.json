{
  "hosting": [
    {
      "target": "engx",
      "public": "www_engx",
      "ignore": [
        "firebase.json",
        "**/*.js.map",
        "**/.*",
        "book.yaml",
        "cover.png"
      ],
      "headers": [
        {
          "source": "version",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
