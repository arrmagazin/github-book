{
  "name": "github-book",
  "private": true,
  "type": "module",
  "description": "Book sites and their EPUB/PDF builds, each from a public GitHub repo of markdown",
  "author": "Company, Inc",
  "scripts": {
    "dev:engx": "SITE=engx PORT=${PORT:-8092} npm run start",
    "dev:almaat": "SITE=almaat PORT=${PORT:-8091} npm run start",
    "start": "npm run stop && npx --yes npm-run-all --parallel start:*",
    "start:serve": "bun ./scripts/serve.ts",
    "start:css": "npm run build:css -- --watch",
    "start:open": "npx --yes wait-on http://localhost:${PORT:?no port} && open http://localhost:${PORT:?no port}/",
    "stop": "lsof -t -sTCP:LISTEN -i tcp:${PORT:-8092} | xargs -r kill -9",
    "gen:index:engx": "npm run gen:index -- \"arrmagazin/engx/1.0.2/docs\"",
    "gen:index:almaat": "npm run gen:index -- \"arrmagazin/almaat/v1.0.7/docs\"",
    "gen:index": "bun --loader .xml:txt ./scripts/generateIndexHtml.ts",
    "build": "npx --yes npm-run-all --parallel build:*",
    "build:ts": "bun ./scripts/build.ts",
    "build:css": "npx --yes @tailwindcss/cli -i index.css -o \"./www_${SITE:?set SITE=<site>}/dist/index.css\"",
    "book": "bun ./book/build.ts",
    "deploy:engx": "SITE=engx PORT=${PORT:-8092} npm run deploy",
    "deploy:almaat": "SITE=almaat PORT=${PORT:-8091} npm run deploy",
    "predeploy": "npm run build",
    "deploy": "./scripts/deploy.sh \"${SITE:?set SITE=<site>}\"",
    "new-site": "bun ./scripts/new-site.ts",
    "postinstall": "npm run link",
    "link": "./scripts/link-modules.sh arrmatura-books arrmatura ultimus && ./scripts/link-shared.sh"
  },
  "devDependencies": {
    "@types/node": "^26.5.1"
  },
  "dependencies": {
    "daisyui": "^5.7.37",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
