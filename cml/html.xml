<Component id="Html">
  <html lang="en" data-theme="{R.theme.name}">
    <Head>
      <Slot Key="head" />
    </Head>
    <body class="{bodyClass}">
      <script>if (localStorage.theme ? localStorage.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches) document.body.dataset.theme = 'dark';</script>
      <Slot />
    </body>
    <script src="https://cdn.jsdelivr.net/gh/arrmatura/arrmatura-books@1.1.5/dist/index.min.js" type="module" If="!static"></script>
  </html>
</Component>
